class MUSUBI:
    def __init__(self):
        self.tie_rules = {}
        self.knot_rules = {}
        self.state = ""

    def load(self, seed):
        self.state = seed

    def tie(self, src, dst):
        self.tie_rules[src] = dst

    def knot(self, src, dst):
        self.knot_rules[src] = dst

    def apply_rules(self):
        out = ""
        for s in self.state:
            if s in self.tie_rules:
                out += self.tie_rules[s]
            elif s in self.knot_rules:
                out += self.knot_rules[s]
            else:
                out += s
        self.state = out

    def cut(self):
        self.state = "".join([s for s in self.state if s.isupper()])

    def weave(self):
        self.state = "".join([s*2 for s in self.state])

    def mirror(self):
        self.state = self.state[::-1]

    def update(self):
        self.apply_rules()   # tie -> knot
        self.cut()
        self.weave()
        self.mirror()

    def evolve(self, steps):
        for _ in range(steps):
            self.update()

