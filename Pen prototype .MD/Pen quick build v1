def musubi_encode(text):
    return "".join(chr((ord(c) % 26) + ord('A')) for c in text)

def musubi_decode(encoded):
    return encoded   # identity placeholder

def musubi_transform(text, steps=3):
    m = MUSUBI()
    seed = musubi_encode(text)
    m.load(seed)
    m.tie("A", "AB")
    m.knot("B", "A")
    m.evolve(steps)
    return m.state

