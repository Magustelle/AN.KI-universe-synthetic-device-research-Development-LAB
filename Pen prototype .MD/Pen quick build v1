std::string sha256(const std::string& data) {
    unsigned char hash[SHA256_DIGEST_LENGTH];
    SHA256((unsigned char*)data.c_str(), data.size(), hash);
    char buf[2*SHA256_DIGEST_LENGTH+1];
    buf[2*SHA256_DIGEST_LENGTH] = 0;
