  '((00 . ORIGIN)
    (01 . PULSE)
    (10 . FLOW)
    (11 . INFINITY)))

(defun execute-glyph (glyph stack)
  (let ((op (cdr (assoc glyph *glyph-map*))))
    (cond
      ((equal op 'ORIGIN) (cons 0 stack))            ; canonical 0
      ((equal op 'PULSE)  (cons (if (car stack) 0 1) (cdr stack)))
      ((equal op 'FLOW)   (append stack '(FLOW)))    ; weave
      ((equal op 'INFINITY) (list 'HALT))
      (t stack))))

