def rotate(x, y, angle):
    c = np.cos(angle)
    s = np.sin(angle)


    return (
        x * c - y * s,
        x * s + y * c
    )




def ellipse(rx, ry, n=800, phase=0.0):
    t = np.linspace(0, 2 * np.pi, n)


    return (
        rx * np.cos(t + phase),
        ry * np.sin(t + phase)
    )




def projection_shape(length, width, n=500):
    """
    One organic closed projection extending along +X.
    """


    t = np.linspace(-1, 1, n)


    # pointed ends + broad middle
    envelope = np.sqrt(np.maximum(0, 1 - t**2))


    x = length * t


    y = (
        width
        * envelope
        * (
            0.78
            + 0.22 * np.cos(np.pi * t)
        )
    )


    # close lower side
    x_full = np.concatenate([
        x,
        x[::-1]
    ])


    y_full = np.concatenate([
        y,
        -y[::-1]
    ])


    return x_full, y_full




